+#include "IOSMCUserClient.h"
+#include <cstring>
+#include <ctime>
+#include "IOSMCKeysData.inc"
+
+namespace
+{
+
+// AppleSMC's kSMCHandleYPCEvent argument, as every SMC client declares it.
+struct SMCKeyData
+{
+	uint32_t key;
+	struct { uint8_t major, minor, build, reserved; uint16_t release; } vers;
+	struct { uint16_t version, length; uint32_t cpuPLimit, gpuPLimit, memPLimit; } pLimitData;
+	struct { uint32_t dataSize, dataType; uint8_t dataAttributes; } keyInfo;
+	uint8_t result, status, data8;
+	uint32_t data32;
+	uint8_t bytes[32];
+};
+static_assert(sizeof(SMCKeyData) == 80, "SMCKeyData layout");
+
+enum
+{
+	kSMCUserClientOpen = 0, kSMCUserClientClose = 1, kSMCHandleYPCEvent = 2,
+	kSMCReadKey = 5, kSMCWriteKey = 6, kSMCGetKeyFromIndex = 8, kSMCGetKeyInfo = 9,
+	kSMCSuccess = 0, kSMCError = 1, kSMCKeyNotFound = 0x84, kSMCNotWritable = 0x86, kSMCBadCommand = 0x82,
+};
+
+const size_t kKeyCount = sizeof(kSMCRecordedKeys) / sizeof(kSMCRecordedKeys[0]);
+
+uint32_t fourCC(const char* text)
+{
+	return (uint32_t(uint8_t(text[0])) << 24) | (uint32_t(uint8_t(text[1])) << 16)
+		| (uint32_t(uint8_t(text[2])) << 8) | uint32_t(uint8_t(text[3]));
+}
+
+const SMCRecordedKey* find(uint32_t key)
+{
+	for (size_t i = 0; i < kKeyCount; i++)
+		if (fourCC(kSMCRecordedKeys[i].key) == key)
+			return &kSMCRecordedKeys[i];
+	return nullptr;
+}
+
+uint32_t fnv(const std::string& text, uint32_t hash = 2166136261u)
+{
+	for (unsigned char c : text)
+		hash = (hash ^ c) * 16777619u;
+	return hash;
+}
+
+}
+
+AppleSMCUserClient::AppleSMCUserClient(const std::string& serial, const std::string& mac)
+: m_serial(serial), m_mac(mac)
+{
+}
+
+const char* AppleSMCUserClient::className() const
+{
+	return "AppleSMCClient";
+}
