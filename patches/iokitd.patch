+namespace DarlingPlatformIdentity {
+inline bool printable(id value, size_t maximum) {
+    if (![value isKindOfClass:[NSString class]]) return false;
+    const char* text = [value UTF8String];
+    if (!text) return false;
+    size_t length = strlen(text);
+    if (!length || length > maximum || length != [value length]) return false;
+    for (size_t i = 0; i < length; ++i) if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126) return false;
+    return true;
+}
+
+// Validate the entire schema before exposing any overrides. Strings on device
+// tree properties are NUL-terminated NSData; serial/UUID retain NSString types.
+inline NSDictionary* properties(id configuration) {
+    if (![configuration isKindOfClass:[NSDictionary class]] || [configuration count] != 2) return nil;
+    id schema = [configuration objectForKey:@"schema"];
+    if (![schema isKindOfClass:[NSNumber class]] || CFGetTypeID((CFTypeRef)schema) == CFBooleanGetTypeID() ||
+        strchr("fd", [schema objCType][0]) || [schema longLongValue] != 1) return nil;
+    id source = [configuration objectForKey:@"properties"];
+    // Up to the full identity set; the loop below rejects any key outside the
+    // accepted set (11 today: UUID, provisioning_UDID, ROM, system-id, serial,
+    // manufacturer, model, product-name, board-id, mlb-serial-number, target-type),
+    // so this is only a sanity bound. It was 10 and silently rejected every
+    // provisioned plist once target-type made the set 11.
+    if (![source isKindOfClass:[NSDictionary class]] || [source count] > 16) return nil;
+    NSMutableDictionary* result = [NSMutableDictionary dictionary];
+    for (id key in source) {
+        if (![key isKindOfClass:[NSString class]]) return nil;
+        id value = [source objectForKey:key];
+        if ([key isEqual:@"IOPlatformUUID"] || [key isEqual:@"provisioning_UDID"]) {
+            if (!printable(value, 36) || [value length] != 36) return nil;
+            uuid_t uuid;
+            if (uuid_parse([value UTF8String], uuid) || uuid_is_null(uuid)) return nil;
+            uuid_string_t text; uuid_unparse_upper(uuid, text);
+            result[key] = [NSString stringWithUTF8String:text];
+            if ([key isEqual:@"provisioning_UDID"]) continue;
+            unsigned char bytes[16]; memcpy(bytes, uuid, sizeof(bytes));
+            for (int i = 0; i < 4; ++i) bytes[i] = uuid[3-i];
+            bytes[4] = uuid[5]; bytes[5] = uuid[4]; bytes[6] = uuid[7]; bytes[7] = uuid[6];
+            NSData* systemID = [NSData dataWithBytes:bytes length:16];
+            if (source[@"system-id"] && ![source[@"system-id"] isEqual:systemID]) return nil;
+            result[@"system-id"] = systemID;
+        } else if ([key isEqual:@"ROM"] || [key isEqual:@"system-id"]) {
+            if (![value isKindOfClass:[NSData class]] || [value length] != ([key isEqual:@"ROM"] ? 6 : 16)) return nil;
+            result[key] = value;
+        } else if ([key isEqual:@"IOPlatformSerialNumber"]) {
+            if (!printable(value, 64)) return nil;
+            result[key] = value;
+        } else if ([key isEqual:@"manufacturer"] || [key isEqual:@"model"] || [key isEqual:@"product-name"] ||
+                   [key isEqual:@"board-id"] || [key isEqual:@"mlb-serial-number"] || [key isEqual:@"target-type"]) {
+            if (!printable(value, [key isEqual:@"mlb-serial-number"] ? 64 : 128)) return nil;
+            const char* text = [value UTF8String];
+            result[key] = [NSData dataWithBytes:text length:strlen(text)+1];
+        } else return nil;
+    }
+    if (result[@"provisioning_UDID"] && result[@"IOPlatformUUID"] &&
+        ![result[@"provisioning_UDID"] isEqual:result[@"IOPlatformUUID"]]) return nil;
+    if (result[@"model"] && !result[@"product-name"]) result[@"product-name"] = result[@"model"];
+    return result;
+}
+
+inline NSDictionary* load(const char* path) {
+    FILE* file = fopen(path, "rb");
+    if (!file) return nil; // no overrides is the normal, unchanged default
+    std::array<unsigned char, 65537> buffer;
+    size_t size = fread(buffer.data(), 1, buffer.size(), file);
+    bool failed = ferror(file); fclose(file);
+    if (!failed && size <= 65536) {
+        NSData* data = [NSData dataWithBytes:buffer.data() length:size];
+        id config = [NSPropertyListSerialization propertyListWithData:data options:NSPropertyListImmutable format:NULL error:NULL];
+        NSDictionary* overrides = properties(config);
+        if (overrides) return overrides;
+    }
+    fprintf(stderr, "iokitd: invalid darling-platform.plist; retaining default platform properties\n");
+    return nil;
+}
+}
+#endif
diff --git a/src/IOGraphicsDevices.h b/src/IOGraphicsDevices.h
new file mode 100644
--- /dev/null
+++ b/src/IOGraphicsDevices.h
@@ -0,0 +1,65 @@
+#ifndef IOKITD_IOGRAPHICSDEVICES_H
+#define IOKITD_IOGRAPHICSDEVICES_H
+
+#include "IOService.h"
+#include "ServiceRegistry.h"
+#include <cstdint>
+#include <string>
+
+// The GPUs of a MacBookPro16,1, as Metal reports them: an IOPCIDevice per host GPU with an
+// accelerator child whose registry entry ID is the MTLDevice.registryID. Apps follow that ID to
+// read the PCI vendor and device IDs (Dawn's GetDeviceIORegistryPCIInfo, ANGLE's GetPCIDevices).
+//
+// Keep the IDs and the vendor mapping in sync with private-include/Metal/MTLDeviceInfo.h
+// (kDiscreteRegistryID, kIntegratedRegistryID, registryIDForVendor and macGpuName).
+namespace IOGraphicsIdentity
+{
+	static constexpr uint64_t kDiscreteRegistryID = 0x100000439ULL;
+	static constexpr uint64_t kIntegratedRegistryID = 0x100000427ULL;
+
+	struct Profile
+	{
+		uint32_t vendorID, deviceID, revisionID;
+		const char* model;            // nullptr: the host's own GPU, whose Metal name iokitd cannot know
+		const char* pciName;          // MacBookPro16,1 ACPI name
+		const char* acceleratorClass;
+		uint64_t registryID;
+		uint32_t vramMB;              // 0: shares system memory, or unknown
+	};
+
+	// Host PCI vendor/device/revision -> the identity reported for it; false for vendors Metal
+	// never maps (the GPU is then left out). AMD and Intel take the MacBookPro16,1 GPU of the same
+	// vendor; NVIDIA keeps its own IDs, as Metal keeps its own name.
+	bool profileForHost(uint32_t vendorID, uint32_t deviceID, uint32_t revisionID, Profile* profile);
+}
+
+class IOPCIDevice : public IOService
+{
+public:
+	explicit IOPCIDevice(const IOGraphicsIdentity::Profile& profile) : m_profile(profile) {}
+	const char* className() const override;
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+private:
+	IOGraphicsIdentity::Profile m_profile;
+};
+
+class IOGraphicsAccelerator : public IOService
+{
+public:
+	explicit IOGraphicsAccelerator(const IOGraphicsIdentity::Profile& profile);
+	const char* className() const override;
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+	bool conformsTo(const char* className) override;
+private:
+	IOGraphicsIdentity::Profile m_profile;
+};
+
+namespace IOGraphicsDevices
+{
+	// Publishes one integrated and one discrete GPU at most, from the host's DRM cards.
+	void discoverDevices(ServiceRegistry* registry, IORegistryEntry* platform);
+}
+
+#endif
diff --git a/src/IOGraphicsDevices.mm b/src/IOGraphicsDevices.mm
new file mode 100644
index 0000000..771187f
--- /dev/null
+++ b/src/IOGraphicsDevices.mm
@@ -0,0 +1,280 @@
+#include "IOGraphicsDevices.h"
+#include "IOStaticRegistry.h"
+#import <Foundation/NSArray.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSNumber.h>
+#import <Foundation/NSString.h>
+#include <os/log.h>
+#include <dirent.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+
+using IOGraphicsIdentity::Profile;
+
+static const char* const kHostDrmDir = "/Volumes/SystemRoot/sys/class/drm";
+
+// darling-lol: the per-prefix runtime identity (configure-darling-platform.py
+// --hardware-profile) names the Mac's GPUs; libsystem_kernel and Metal read the
+// same file, so IOKit, Metal and system_profiler agree.
+static bool runtimeIdentity(const char* key, std::string* value)
+{
+	FILE* file = fopen("/private/etc/darling-runtime-identity.conf", "r");
+	if (!file)
+		return false;
+	char line[512];
+	const size_t keyLength = std::strlen(key);
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), file))
+	{
+		line[std::strcspn(line, "\r\n")] = '\0';
+		if (std::strncmp(line, key, keyLength) == 0 && line[keyLength] == '=' && line[keyLength + 1])
+		{
+			value->assign(line + keyLength + 1);
+			found = true;
+		}
+	}
+	fclose(file);
+	return found;
+}
+
+static bool configuredProfile(const char* slot, Profile* profile)
+{
+	// Names outlive the call: IOPCIDevice keeps the pointer.
+	static std::map<std::string, std::string> names;
+	std::string prefix = std::string("gpu.") + slot + ".";
+	std::string name, vendor, device;
+	if (!runtimeIdentity((prefix + "name").c_str(), &name) ||
+		!runtimeIdentity((prefix + "vendor").c_str(), &vendor) ||
+		!runtimeIdentity((prefix + "device").c_str(), &device))
+		return false;
+	char* end = nullptr;
+	const unsigned long vendorID = strtoul(vendor.c_str(), &end, 16);
+	if (*end || vendorID > 0xffff)
+		return false;
+	const unsigned long deviceID = strtoul(device.c_str(), &end, 16);
+	if (*end || deviceID > 0xffff)
+		return false;
+	std::string& stored = names[slot];
+	stored = name;
+	profile->vendorID = uint32_t(vendorID);
+	profile->deviceID = uint32_t(deviceID);
+	profile->model = stored.c_str();
+	if (vendorID == 0x8086)
+	{
+		profile->pciName = "IGPU";
+		profile->acceleratorClass = "IntelAccelerator";
+		profile->registryID = IOGraphicsIdentity::kIntegratedRegistryID;
+		profile->vramMB = 0;
+	}
+	else
+	{
+		profile->pciName = "GFX0";
+		profile->acceleratorClass = "AMDRadeonX6000_AMDNavi14GraphicsAccelerator";
+		profile->registryID = IOGraphicsIdentity::kDiscreteRegistryID;
+		profile->vramMB = 4096;
+	}
+	return true;
+}
+
+bool IOGraphicsIdentity::profileForHost(uint32_t vendorID, uint32_t deviceID, uint32_t revisionID, Profile* profile)
+{
+	// A configured Mac profile replaces every host GPU with that Mac's GPU of the same
+	// role: Intel is the integrated one, AMD and NVIDIA the discrete one.
+	if (vendorID == 0x8086 || vendorID == 0x1002 || vendorID == 0x10de)
+	{
+		if (configuredProfile(vendorID == 0x8086 ? "integrated" : "discrete", profile))
+		{
+			profile->revisionID = revisionID;
+			return true;
+		}
+		// A provisioned integrated-only Mac (e.g. a Mac mini) configures the integrated
+		// GPU but no discrete one: its host discrete GPUs must not be published at all,
+		// instead of falling back to a default AMD/NVIDIA this Mac never had.
+		if (vendorID == 0x1002 || vendorID == 0x10de)
+		{
+			Profile integrated;
+			if (configuredProfile("integrated", &integrated))
+				return false;
+		}
+	}
+
+	switch (vendorID)
+	{
+	case 0x1002:
+		*profile = { 0x1002, 0x7340, revisionID, "AMD Radeon Pro 5500M", "GFX0",
+			"AMDRadeonX6000_AMDNavi14GraphicsAccelerator", kDiscreteRegistryID, 4096 };
+		return true;
+	case 0x8086:
+		*profile = { 0x8086, 0x3e9b, revisionID, "Intel UHD Graphics 630", "IGPU",
+			"IntelAccelerator", kIntegratedRegistryID, 0 };
+		return true;
+	case 0x10de:
+		*profile = { 0x10de, deviceID, revisionID, nullptr, "GFX0", "nvAccelerator", kDiscreteRegistryID, 0 };
+		return true;
+	default:
+		return false;
+	}
+}
+
+// PCI configuration values are 32-bit little-endian data, as on macOS
+static NSData* pciValue(uint32_t value)
+{
+	const uint8_t bytes[4] = { uint8_t(value), uint8_t(value >> 8), uint8_t(value >> 16), uint8_t(value >> 24) };
+	return [NSData dataWithBytes: bytes length: sizeof(bytes)];
+}
+
+static NSData* dataForString(const char* string)
+{
+	return [NSData dataWithBytes: string length: strlen(string) + 1];
+}
+
+const char* IOPCIDevice::className() const
+{
+	return "IOPCIDevice";
+}
+
+NSDictionary* IOPCIDevice::matchingDictionary()
+{
+	return @{
+		@"IOProviderClass": @"IOPCIDevice",
+		@"IOClass": @"IOPCIDevice",
+	};
+}
+
+NSDictionary* IOPCIDevice::getProperties()
+{
+	NSMutableDictionary* properties = [NSMutableDictionary dictionaryWithDictionary: @{
+		@"IOName": @"display",
+		@"name": dataForString("display"),
+		@"vendor-id": pciValue(m_profile.vendorID),
+		@"device-id": pciValue(m_profile.deviceID),
+		@"revision-id": pciValue(m_profile.revisionID),
+		@"class-code": pciValue(0x030000), // display controller, VGA compatible
+	}];
+	if (m_profile.model)
+		properties[@"model"] = dataForString(m_profile.model);
+	if (m_profile.vramMB)
+		properties[@"VRAM,totalMB"] = @(m_profile.vramMB);
+	return properties;
+}
+
+IOGraphicsAccelerator::IOGraphicsAccelerator(const Profile& profile)
+: IOService(profile.registryID), m_profile(profile)
+{
+}
+
+const char* IOGraphicsAccelerator::className() const
+{
+	return m_profile.acceleratorClass;
+}
+
+NSDictionary* IOGraphicsAccelerator::matchingDictionary()
+{
+	return @{
+		@"IOProviderClass": @[ [NSString stringWithUTF8String: m_profile.acceleratorClass], @"IOAccelerator", @"IOGraphicsAccelerator2" ],
+		@"IOClass": [NSString stringWithUTF8String: m_profile.acceleratorClass],
+	};
+}
+
+NSDictionary* IOGraphicsAccelerator::getProperties()
+{
+	return @{
+		@"IOClass": [NSString stringWithUTF8String: m_profile.acceleratorClass],
+		@"IOProviderClass": @"IOPCIDevice",
+		@"IOMatchCategory": @"IOAccelerator",
+	};
+}
+
+bool IOGraphicsAccelerator::conformsTo(const char* className)
+{
+	if (std::strcmp(className, "IOAccelerator") == 0 || std::strcmp(className, "IOGraphicsAccelerator2") == 0)
+		return true;
+	return IOService::conformsTo(className);
+}
+
+static bool readHex(const std::string& path, uint32_t* value)
+{
+	FILE* file = fopen(path.c_str(), "r");
+	if (!file)
+		return false;
+	char buffer[32] = {};
+	const bool read = fgets(buffer, sizeof(buffer), file) != nullptr;
+	fclose(file);
+	if (!read)
+		return false;
+	char* end = nullptr;
+	const unsigned long parsed = strtoul(buffer, &end, 16);
+	if (end == buffer || parsed > UINT32_MAX)
+		return false;
+	*value = uint32_t(parsed);
+	return true;
+}
+
+void IOGraphicsDevices::discoverDevices(ServiceRegistry* registry, IORegistryEntry* platform)
+{
+	// cardN only (cardN-<connector> entries are outputs), in card order
+	std::map<long, std::string> cards;
+	if (DIR* dir = opendir(kHostDrmDir))
+	{
+		while (struct dirent* entry = readdir(dir))
+		{
+			const char* name = entry->d_name;
+			if (std::strncmp(name, "card", 4) != 0 || !name[4])
+				continue;
+			char* end = nullptr;
+			const long index = strtol(name + 4, &end, 10);
+			if (*end == '\0' && index >= 0)
+				cards.emplace(index, std::string(kHostDrmDir) + "/" + name + "/device/");
+		}
+		closedir(dir);
+	}
+
+	bool published[2] = { false, false }; // integrated, discrete
+	for (const auto& card : cards)
+	{
+		uint32_t vendorID, deviceID, revisionID = 0;
+		if (!readHex(card.second + "vendor", &vendorID) || !readHex(card.second + "device", &deviceID))
+			continue;
+		readHex(card.second + "revision", &revisionID);
+
+		Profile profile;
+		if (!IOGraphicsIdentity::profileForHost(vendorID, deviceID, revisionID, &profile))
+			continue;
+		bool& slot = published[profile.registryID == IOGraphicsIdentity::kDiscreteRegistryID];
+		if (slot)
+			continue;
+
+		IOPCIDevice* device = new IOPCIDevice(profile);
+		IOGraphicsAccelerator* accelerator = new IOGraphicsAccelerator(profile);
+		if (accelerator->id() != profile.registryID)
+		{
+			// Metal would point at another entry; leave this GPU out rather than mislead
+			os_log_error(OS_LOG_DEFAULT, "iokitd: registry ID %llx is taken; %s not published",
+				(unsigned long long) profile.registryID, profile.acceleratorClass);
+			delete accelerator;
+			delete device;
+			continue;
+		}
+		// The recorded plane has the integrated GPU's PCI device with the model's
+		// own properties; the accelerator stands below it.
+		IORegistryEntry* recorded = profile.registryID == IOGraphicsIdentity::kIntegratedRegistryID
+			? IOStaticRegistry::find("IGPU@2") : nullptr;
+		if (recorded)
+		{
+			delete device;
+			accelerator->registerInPlane(kIOServicePlane, profile.acceleratorClass, recorded);
+		}
+		else
+		{
+			device->registerInPlane(kIOServicePlane, profile.pciName, platform);
+			accelerator->registerInPlane(kIOServicePlane, profile.acceleratorClass, device);
+			registry->registerService(device);
+		}
+		registry->registerService(accelerator);
+		slot = true;
+	}
+}
diff --git a/src/IOHardwareDevices.h b/src/IOHardwareDevices.h
new file mode 100644
index 0000000..203c983
--- /dev/null
+++ b/src/IOHardwareDevices.h
@@ -0,0 +1,72 @@
+#ifndef IOKITD_IOHARDWAREDEVICES_H
+#define IOKITD_IOHARDWAREDEVICES_H
+
+#include "IOService.h"
+#include "ServiceRegistry.h"
+#include <cstdint>
+#include <string>
+
+// The built-in network and storage of a MacBookPro16,1, enough for the hardware
+// identifiers anti-cheat and licensing code reads from IOKit: the primary MAC
+// address (IONetworkController's IOMACAddress, under an en0 IOEthernetInterface)
+// and the internal SSD serial (IONVMeController's "Serial Number", over an
+// IOMedia whole-disk nub). Values come from the per-prefix runtime identity
+// (net.en0.ether, hw.disk.serial, hw.disk.model, hw.disk.size); without them no
+// nub is published, so a prefix that was never provisioned is unchanged.
+
+class IONetworkController : public IOService
+{
+public:
+	explicit IONetworkController(const uint8_t mac[6]);
+	const char* className() const override { return "IONetworkController"; }
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+	bool conformsTo(const char* className) override;
+private:
+	uint8_t m_mac[6];
+};
+
+class IOEthernetInterface : public IOService
+{
+public:
+	explicit IOEthernetInterface(const uint8_t mac[6]) : m_mac{ mac[0], mac[1], mac[2], mac[3], mac[4], mac[5] } {}
+	const char* className() const override { return "IOEthernetInterface"; }
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+	bool conformsTo(const char* className) override;
+private:
+	uint8_t m_mac[6];
+};
+
+class IONVMeController : public IOService
+{
+public:
+	IONVMeController(std::string serial, std::string model);
+	const char* className() const override { return "IONVMeController"; }
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+	bool conformsTo(const char* className) override;
+private:
+	std::string m_serial, m_model;
+};
+
+class IOMediaWholeDisk : public IOService
+{
+public:
+	explicit IOMediaWholeDisk(uint64_t size) : m_size(size) {}
+	const char* className() const override { return "IOMedia"; }
+	NSDictionary* matchingDictionary() override;
+	NSDictionary* getProperties() override;
+	bool conformsTo(const char* className) override;
+private:
+	uint64_t m_size;
+};
+
+namespace IOHardwareDevices
+{
+	// Publishes the en0 network controller/interface and the internal NVMe
+	// controller with its whole-disk IOMedia, when the identity provides them.
+	void discoverDevices(ServiceRegistry* registry, IORegistryEntry* platform);
+}
+
+#endif
diff --git a/src/IOHardwareDevices.mm b/src/IOHardwareDevices.mm
new file mode 100644
index 0000000..e78274f
--- /dev/null
+++ b/src/IOHardwareDevices.mm
@@ -0,0 +1,205 @@
+#include "IOHardwareDevices.h"
+#import <Foundation/NSArray.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSNumber.h>
+#import <Foundation/NSString.h>
+#include <os/log.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+// Same per-prefix identity file the GPU and libsystem_kernel code reads.
+static bool runtimeIdentity(const char* key, std::string* value)
+{
+	FILE* file = fopen("/private/etc/darling-runtime-identity.conf", "r");
+	if (!file)
+		return false;
+	char line[512];
+	const size_t keyLength = std::strlen(key);
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), file))
+	{
+		line[std::strcspn(line, "\r\n")] = '\0';
+		if (std::strncmp(line, key, keyLength) == 0 && line[keyLength] == '=' && line[keyLength + 1])
+		{
+			value->assign(line + keyLength + 1);
+			found = true;
+		}
+	}
+	fclose(file);
+	return found;
+}
+
+// "xx:xx:xx:xx:xx:xx" -> six bytes; false unless exactly that shape.
+static bool parseMac(const std::string& text, uint8_t out[6])
+{
+	if (text.size() != 17)
+		return false;
+	for (int i = 0; i < 6; i++)
+	{
+		char* end = nullptr;
+		const unsigned long byte = strtoul(text.c_str() + i * 3, &end, 16);
+		if (end != text.c_str() + i * 3 + 2 || byte > 0xff)
+			return false;
+		if (i < 5 && text[i * 3 + 2] != ':')
+			return false;
+		out[i] = uint8_t(byte);
+	}
+	return true;
+}
+
+static NSData* macData(const uint8_t mac[6])
+{
+	return [NSData dataWithBytes: mac length: 6];
+}
+
+// ------------------------------------------------------------------ network
+
+IONetworkController::IONetworkController(const uint8_t mac[6])
+{
+	std::memcpy(m_mac, mac, 6);
+}
+
+NSDictionary* IONetworkController::matchingDictionary()
+{
+	return @{ @"IOProviderClass": @"IONetworkController", @"IOClass": @"IONetworkController" };
+}
+
+NSDictionary* IONetworkController::getProperties()
+{
+	return @{
+		@"IOClass": @"AppleBCMWLANCore",
+		@"IOMACAddress": macData(m_mac),
+		@"IOModel": @"Wi-Fi",
+		@"IOBuiltin": @YES,
+	};
+}
+
+bool IONetworkController::conformsTo(const char* className)
+{
+	if (std::strcmp(className, "IONetworkController") == 0)
+		return true;
+	return IOService::conformsTo(className);
+}
+
+NSDictionary* IOEthernetInterface::matchingDictionary()
+{
+	return @{ @"IOProviderClass": @"IOEthernetInterface", @"IOClass": @"IOEthernetInterface" };
+}
+
+NSDictionary* IOEthernetInterface::getProperties()
+{
+	return @{
+		@"IOClass": @"IOEthernetInterface",
+		@"IOMACAddress": macData(m_mac),
+		@"BSD Name": @"en0",
+		@"IOInterfaceType": @6,          // IFT_ETHER / IEEE 802.3
+		@"IOInterfaceUnit": @0,
+		@"IOInterfaceNamePrefix": @"en",
+		@"IOPrimaryInterface": @YES,
+		@"IOBuiltin": @YES,
+	};
+}
+
+bool IOEthernetInterface::conformsTo(const char* className)
+{
+	if (std::strcmp(className, "IOEthernetInterface") == 0 || std::strcmp(className, "IONetworkInterface") == 0)
+		return true;
+	return IOService::conformsTo(className);
+}
+
+// ------------------------------------------------------------------ storage
+
+IONVMeController::IONVMeController(std::string serial, std::string model)
+: m_serial(std::move(serial)), m_model(std::move(model))
+{
+}
+
+NSDictionary* IONVMeController::matchingDictionary()
+{
+	return @{ @"IOProviderClass": @"IONVMeController", @"IOClass": @"IONVMeController" };
+}
+
+NSDictionary* IONVMeController::getProperties()
+{
+	return @{
+		@"IOClass": @"IONVMeController",
+		@"Model": [NSString stringWithUTF8String: m_model.c_str()],
+		@"Serial Number": [NSString stringWithUTF8String: m_serial.c_str()],
+		@"IOBuiltin": @YES,
+	};
+}
+
+bool IONVMeController::conformsTo(const char* className)
+{
+	if (std::strcmp(className, "IONVMeController") == 0 || std::strcmp(className, "IOBlockStorageDevice") == 0)
+		return true;
+	return IOService::conformsTo(className);
+}
+
+NSDictionary* IOMediaWholeDisk::matchingDictionary()
+{
+	return @{ @"IOProviderClass": @"IOMedia", @"IOClass": @"IOMedia" };
+}
+
+NSDictionary* IOMediaWholeDisk::getProperties()
+{
+	return @{
+		@"IOClass": @"IOMedia",
+		@"BSD Name": @"disk0",
+		@"Whole": @YES,
+		@"Leaf": @NO,
+		@"Writable": @YES,
+		@"Removable": @NO,
+		@"Ejectable": @NO,
+		@"Size": @(m_size),
+		@"Preferred Block Size": @4096,
+		@"Content": @"",
+	};
+}
+
+bool IOMediaWholeDisk::conformsTo(const char* className)
+{
+	if (std::strcmp(className, "IOMedia") == 0 || std::strcmp(className, "IOStorage") == 0)
+		return true;
+	return IOService::conformsTo(className);
+}
+
+// ------------------------------------------------------------------ publish
+
+void IOHardwareDevices::discoverDevices(ServiceRegistry* registry, IORegistryEntry* platform)
+{
+	std::string macText;
+	uint8_t mac[6];
+	if (runtimeIdentity("net.en0.ether", &macText) && parseMac(macText, mac))
+	{
+		IONetworkController* controller = new IONetworkController(mac);
+		IOEthernetInterface* interface = new IOEthernetInterface(mac);
+		controller->registerInPlane(kIOServicePlane, "en0", platform);
+		interface->registerInPlane(kIOServicePlane, "en0", controller);
+		registry->registerService(controller);
+		registry->registerService(interface);
+	}
+
+	std::string serial, model, sizeText;
+	if (runtimeIdentity("hw.disk.serial", &serial) && !serial.empty())
+	{
+		if (!runtimeIdentity("hw.disk.model", &model) || model.empty())
+			model = "APPLE SSD";
+		uint64_t size = 500277790720ULL; // 512 GB, as Apple reports it
+		if (runtimeIdentity("hw.disk.size", &sizeText))
+		{
+			char* end = nullptr;
+			const unsigned long long parsed = strtoull(sizeText.c_str(), &end, 10);
+			if (end != sizeText.c_str() && *end == '\0' && parsed != 0)
+				size = parsed;
+		}
+		IONVMeController* nvme = new IONVMeController(serial, model);
+		IOMediaWholeDisk* media = new IOMediaWholeDisk(size);
+		nvme->registerInPlane(kIOServicePlane, "AppleANS2Controller", platform);
+		media->registerInPlane(kIOServicePlane, "IOMedia", nvme);
+		registry->registerService(nvme);
+		registry->registerService(media);
+	}
+}
