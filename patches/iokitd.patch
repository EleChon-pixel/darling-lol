+#ifndef IOKITD_IOSMCUSERCLIENT_H
+#define IOKITD_IOSMCUSERCLIENT_H
+#include "IOUserClient.h"
+#include <string>
+
+// darling-lol: the connection IOServiceOpen() returns on AppleSMC. It answers the
+// read-only part of the SMC protocol (key count, key by index, key info, read key)
+// from the keys recorded on a real Mac of the profile's model. Writes are refused,
+// as they are for an unprivileged process on a Mac.
+class AppleSMCUserClient : public IOUserClient
+{
+public:
+	// serial: the platform serial number; mac: en0's address, six bytes or empty.
+	AppleSMCUserClient(const std::string& serial, const std::string& mac);
+
+	const char* className() const override;
+	NSDictionary* matchingDictionary() override;
+	IOExternalMethod* getExternalMethodForIndex(UInt32 index) override;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments* arguments) override;
+private:
+	std::string m_serial, m_mac;
+};
+
+#endif
