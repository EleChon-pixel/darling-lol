+// OOL input ownership transfers to this server; release it on every exit path.
+kern_return_t is_io_registry_entry_from_path_ool(mach_port_t master_port, io_string_inband_t path,
+    io_buf_ptr_t path_ool, mach_msg_type_number_t path_oolCnt, kern_return_t* result, mach_port_t* registry_entry)
+{
+	struct Input {
+		io_buf_ptr_t bytes; mach_msg_type_number_t size;
+		~Input() { if (bytes && size) vm_deallocate(mach_task_self(), (vm_address_t)bytes, size); }
+	} input {path_ool, path_oolCnt};
+	if (!result || !registry_entry) return kIOReturnBadArgument;
+	*registry_entry = MACH_PORT_NULL;
+	*result = kIOReturnBadArgument;
+	std::string_view fullPath;
+	if (path_oolCnt || path_ool) {
+		if (!path_ool || !path_oolCnt || path_oolCnt > 65536 || !path || path[0] ||
+		    strnlen(path_ool, path_oolCnt) != path_oolCnt - 1) return kIOReturnSuccess;
+		fullPath = std::string_view(path_ool, path_oolCnt - 1);
+	} else {
+		if (!path || !memchr(path, 0, sizeof(io_string_inband_t))) return kIOReturnSuccess;
+		fullPath = path;
+	}
+	auto* entry = IORegistryEntry::fromPath(fullPath);
+	if (entry) { *registry_entry = entry->port(); *result = kIOReturnSuccess; }
+	else *result = kIOReturnNoDevice;
+	return kIOReturnSuccess;
+}
+
+kern_return_t is_io_registry_entry_get_path_ool(mach_port_t registry_entry, io_name_t plane,
+    io_string_inband_t path, io_buf_ptr_t* path_ool, mach_msg_type_number_t* path_oolCnt)
+{
+	if (!path || !path_ool || !path_oolCnt) return kIOReturnBadArgument;
+	path[0] = 0; *path_ool = nullptr; *path_oolCnt = 0;
+	auto* entry = dynamic_cast<IORegistryEntry*>(IOObject::lookup(registry_entry));
+	if (!entry || !plane || !memchr(plane, 0, sizeof(io_name_t)) || !entry->inPlane(plane)) return kIOReturnBadArgument;
+	auto value = entry->getPath(plane);
+	if (value == "?unsup_plane?") return kIOReturnBadArgument;
+	if (value.size() < sizeof(io_string_inband_t)) {
+		strlcpy(path, value.c_str(), sizeof(io_string_inband_t));
+	} else {
+		// MIG uses physicalcopy with deallocate=false. The main queue completes
+		// each reply before its next request, so one bounded reusable buffer
+		// keeps the sender's bytes alive without leaking one VM allocation/call.
+		static std::string reply;
+		reply.assign(value);
+		*path_ool = const_cast<char*>(reply.data());
+		*path_oolCnt = reply.size(); // IOKit creates a CFString from bytes, excluding NUL
+	}
+	return kIOReturnSuccess;
+}
+
+kern_return_t is_io_registry_entry_in_plane(mach_port_t registry_entry, io_name_t plane, boolean_t* inPlane)
+{
+	if (!inPlane) return kIOReturnBadArgument;
+	*inPlane = FALSE;
+	auto* entry = dynamic_cast<IORegistryEntry*>(IOObject::lookup(registry_entry));
+	if (!entry || !plane || !memchr(plane, 0, sizeof(io_name_t))) return kIOReturnBadArgument;
+	*inPlane = entry->inPlane(plane);
+	return kIOReturnSuccess;
+}
+
+kern_return_t is_io_registry_entry_get_property_bytes(mach_port_t registry_entry, io_name_t property_name,
+    io_struct_inband_t data, mach_msg_type_number_t* dataCnt)
+{
+	if (!dataCnt) return kIOReturnBadArgument;
+	size_t capacity = std::min<size_t>(*dataCnt, sizeof(io_struct_inband_t));
+	*dataCnt = 0;
+	auto* entry = dynamic_cast<IORegistryEntry*>(IOObject::lookup(registry_entry));
+	if (!entry || !property_name || !memchr(property_name, 0, sizeof(io_name_t))) return kIOReturnBadArgument;
+	NSString* key = [NSString stringWithUTF8String:property_name];
+	if (!key) return kIOReturnBadArgument;
+	id value = [entry->getProperties() objectForKey:key];
+	if (!value) return kIOReturnNoResources;
+	const void* bytes = nullptr;
+	size_t length = 0;
+	uint64_t number = 0;
+	if ([value isKindOfClass:[NSData class]]) {
+		bytes = [value bytes]; length = [value length];
+	} else if ([value isKindOfClass:[NSString class]]) {
+		bytes = [value UTF8String];
+		if (!bytes) return kIOReturnBadArgument;
+		length = strlen((const char*)bytes) + 1;
+	} else if ([value isKindOfClass:[NSNumber class]] && CFGetTypeID((CFTypeRef)value) == CFBooleanGetTypeID()) {
+		bytes = [value boolValue] ? "Yes" : "No";
+		length = [value boolValue] ? sizeof("Yes") : sizeof("No");
+	} else if ([value isKindOfClass:[NSNumber class]]) {
+		const char* type = [value objCType];
+		switch (type ? type[0] : 0) {
+			case 'c': case 'C': case 'B': length = 1; break;
+			case 's': case 'S': length = 2; break;
+			case 'i': case 'I': length = 4; break;
+			case 'l': case 'L': length = sizeof(long); break;
+			case 'q': case 'Q': length = 8; break;
+			default: return kIOReturnBadArgument;
+		}
+		number = [value unsignedLongLongValue]; bytes = &number;
+	} else return kIOReturnBadArgument;
+	if (length > std::numeric_limits<mach_msg_type_number_t>::max()) return kIOReturnNoSpace;
+	if (length > capacity) { *dataCnt = capacity; return kIOReturnIPCError; }
+	*dataCnt = length;
+	if (length && !data) { *dataCnt = 0; return kIOReturnBadArgument; }
+	if (length) memcpy(data, bytes, length);
+	return kIOReturnSuccess;
+}
