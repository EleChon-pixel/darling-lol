+NSDictionary* AppleSMCUserClient::matchingDictionary()
+{
+	return @{};
+}
+
+IOExternalMethod* AppleSMCUserClient::getExternalMethodForIndex(UInt32 index)
+{
+	return nullptr;
+}
+
+IOReturn AppleSMCUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments* arguments)
+{
+	arguments->scalarOutputCount = 0;
+	if (selector == kSMCUserClientOpen || selector == kSMCUserClientClose)
+	{
+		arguments->structureOutputSize = 0;
+		return kIOReturnSuccess;
+	}
+	if (selector != kSMCHandleYPCEvent)
+		return kIOReturnUnsupported;
+	if (arguments->structureInputSize != sizeof(SMCKeyData) || !arguments->structureInput
+		|| arguments->structureOutputSize < sizeof(SMCKeyData) || !arguments->structureOutput)
+		return kIOReturnBadArgument;
+
+	SMCKeyData in, out;
+	std::memcpy(&in, arguments->structureInput, sizeof(in));
+	std::memset(&out, 0, sizeof(out));
+	arguments->structureOutputSize = sizeof(out);
+
+	const SMCRecordedKey* key = nullptr;
+	switch (in.data8)
+	{
+		case kSMCGetKeyFromIndex:
+			if (in.data32 >= kKeyCount)
+				out.result = kSMCKeyNotFound;
+			else
+				out.key = fourCC(kSMCRecordedKeys[in.data32].key);
+			break;
+		case kSMCGetKeyInfo:
+		case kSMCReadKey:
+			key = find(in.key);
+			if (!key)
+			{
+				out.result = kSMCKeyNotFound;
+				break;
+			}
+			out.keyInfo.dataSize = key->size;
+			out.keyInfo.dataType = fourCC(key->type);
+			out.keyInfo.dataAttributes = 0x80; // readable
+			if (in.data8 == kSMCGetKeyInfo)
+				break;
+			std::memcpy(out.bytes, key->bytes, key->size);
+			if (std::strcmp(key->key, "#KEY") == 0)
+			{
+				const uint32_t count = kKeyCount;
+				out.bytes[0] = count >> 24; out.bytes[1] = count >> 16; out.bytes[2] = count >> 8; out.bytes[3] = count;
+			}
+			else if (key->fill == 1) // the system serial, zero padded
+				std::memcpy(out.bytes, m_serial.data(), std::min<size_t>(m_serial.size(), key->size));
+			else if (key->fill == 2 && m_mac.size() == 6)
+				std::memcpy(out.bytes, m_mac.data(), std::min<size_t>(6, key->size));
+			else if (key->fill == 3)
+			{
+				// Board serial and chip ID: stable per prefix, in the recorded shape.
+				static const char alphabet[] = "0123456789ABCDEFGHJKLMNPQRSTUVWXYZ";
+				uint32_t state = fnv(m_serial, fnv(key->key));
+				const bool text = std::strcmp(key->key, "RMSN") == 0;
+				for (size_t i = text ? 0 : 3; i < key->size; i++)
+				{
+					state = state * 1664525u + 1013904223u;
+					out.bytes[i] = text ? alphabet[(state >> 16) % (sizeof(alphabet) - 1)] : uint8_t(state >> 16);
+				}
+			}
+			else if (key->key[0] == 'T' && std::strcmp(key->type, "sp78") == 0 && key->bytes[0] > 20)
+			{
+				// Temperatures drift by a degree or so rather than stand still.
+				const uint32_t step = uint32_t(time(nullptr) / 5) + fourCC(key->key);
+				out.bytes[0] = key->bytes[0] + (step * 2654435761u >> 30) % 3 - 1;
+				out.bytes[1] = uint8_t((step * 40503u) & 0xc0);
+			}
+			break;
+		case kSMCWriteKey:
+			out.result = find(in.key) ? kSMCNotWritable : kSMCKeyNotFound;
+			break;
+		default:
+			out.result = kSMCBadCommand;
+	}
+	std::memcpy(arguments->structureOutput, &out, sizeof(out));
+	return kIOReturnSuccess;
+}
