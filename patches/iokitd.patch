diff --git a/src/IOStaticRegistry.h b/src/IOStaticRegistry.h
new file mode 100644
index 0000000..8bbab78
--- /dev/null
+++ b/src/IOStaticRegistry.h
@@ -0,0 +1,29 @@
+#ifndef IOKITD_IOSTATICREGISTRY_H
+#define IOKITD_IOSTATICREGISTRY_H
+
+#include "IOService.h"
+#include "ServiceRegistry.h"
+
+// The IOService plane of the selected hardware profile, as recorded from a real
+// Mac of that model (tools/build-ioregistry.py makes IOStaticRegistryData.inc):
+// the ACPI and PCI tree, SMC, USB, storage, network, audio and framebuffer
+// entries with their properties. The entries answer registry lookups and
+// matching; they have no user clients. iokitd's live services (platform expert,
+// power management, IOSurface, GPU accelerator, displays) stand where the
+// recording has them. Addresses and serial numbers come from the prefix's
+// runtime identity, never from the recorded machine.
+namespace IOStaticRegistry
+{
+	// Publishes the plane below the platform expert when the runtime identity
+	// selects the recorded model. Otherwise nothing is published and false is
+	// returned, and callers keep the flat layout.
+	bool load(ServiceRegistry* registry, IORegistryEntry* platform);
+
+	// First published entry with this name ("IGPU@2", "IOResources"), or nullptr.
+	IORegistryEntry* find(const char* name);
+
+	// The hardware model of the runtime identity, or an empty string.
+	const char* model();
+}
+
+#endif
diff --git a/src/IOStaticRegistry.mm b/src/IOStaticRegistry.mm
new file mode 100644
index 0000000..71716d1
--- /dev/null
+++ b/src/IOStaticRegistry.mm
@@ -0,0 +1,243 @@
+#include "IOStaticRegistry.h"
+#include "IOGraphicsDevices.h"
+#include "IOPMrootDomain.h"
+#include "IOSurfaceRoot.h"
+#import <Foundation/NSArray.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSNumber.h>
+#import <Foundation/NSPropertyList.h>
+#import <Foundation/NSString.h>
+#include <IOKit/IOKitKeys.h>
+#include <os/log.h>
+#include <zlib.h>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "IOStaticRegistryData.inc"
+
+namespace
+{
+
+std::map<std::string, std::string>& identity()
+{
+	static std::map<std::string, std::string>* values = nullptr;
+	if (values)
+		return *values;
+	values = new std::map<std::string, std::string>;
+	if (FILE* file = fopen("/private/etc/darling-runtime-identity.conf", "r"))
+	{
+		char line[512];
+		while (fgets(line, sizeof(line), file))
+		{
+			line[std::strcspn(line, "\r\n")] = '\0';
+			char* separator = std::strchr(line, '=');
+			if (line[0] == '#' || !separator || !separator[1])
+				continue;
+			values->emplace(std::string(line, separator - line), separator + 1);
+		}
+		fclose(file);
+	}
+	return *values;
+}
+
+// "xx:xx:xx:xx:xx:xx" -> six bytes; nil unless exactly that shape.
+NSData* macData(const std::string& text)
+{
+	uint8_t bytes[6];
+	if (text.size() != 17)
+		return nil;
+	for (int i = 0; i < 6; i++)
+	{
+		char* end = nullptr;
+		const unsigned long byte = strtoul(text.c_str() + i * 3, &end, 16);
+		if (end != text.c_str() + i * 3 + 2 || byte > 0xff || (i < 5 && text[i * 3 + 2] != ':'))
+			return nil;
+		bytes[i] = uint8_t(byte);
+	}
+	return [NSData dataWithBytes: bytes length: 6];
+}
+
+// The address libsystem_kernel gives a secondary interface (sysctl_net.c phantom_mac):
+// en0's, mixed with the interface name, locally administered.
+NSData* derivedMac(NSData* base, const char* name)
+{
+	if (!base)
+		return nil;
+	uint32_t hash = 2166136261u;
+	for (const char* c = name; *c; c++)
+		hash = (hash ^ (unsigned char) *c) * 16777619u;
+	uint8_t out[6];
+	for (int i = 0; i < 6; i++)
+		out[i] = ((const uint8_t*) [base bytes])[i] ^ (uint8_t)(hash >> ((i % 4) * 8));
+	out[0] = (out[0] | 0x02) & ~0x01;
+	return [NSData dataWithBytes: out length: 6];
+}
+
+// The recorded properties plus the identity's values ({"key" or "dict/key": [identity key, kind]}).
+NSDictionary* propertiesFor(NSDictionary* record)
+{
+	NSMutableDictionary* properties = [NSMutableDictionary dictionaryWithDictionary: record[@"P"] ?: @{}];
+	NSDictionary* fills = record[@"I"];
+	for (NSString* path in fills)
+	{
+		NSArray* fill = fills[path];
+		if (![fill isKindOfClass: [NSArray class]] || [fill count] != 2)
+			continue;
+		auto found = identity().find([fill[0] UTF8String]);
+		if (found == identity().end())
+			continue;
+		NSString* kind = fill[1];
+		id value = [kind isEqual: @"mac"] ? (id) macData(found->second)
+			: [kind hasPrefix: @"mac~"] ? (id) derivedMac(macData(found->second), [[kind substringFromIndex: 4] UTF8String])
+			: (id) [NSString stringWithUTF8String: found->second.c_str()];
+		if (!value)
+			continue;
+		NSArray* parts = [path componentsSeparatedByString: @"/"];
+		if ([parts count] == 1)
+			properties[path] = value;
+		else if ([parts count] == 2)
+		{
+			NSMutableDictionary* inner = [NSMutableDictionary dictionaryWithDictionary:
+				[properties[parts[0]] isKindOfClass: [NSDictionary class]] ? properties[parts[0]] : @{}];
+			inner[parts[1]] = value;
+			properties[parts[0]] = inner;
+		}
+	}
+	return properties;
+}
+
+class IOStaticService : public IOService
+{
+public:
+	IOStaticService(uint64_t registryID, NSDictionary* record)
+	: IOService(registryID), m_class([record[@"c"] UTF8String])
+	{
+		NSString* name = record[@"n"];
+		NSRange at = [name rangeOfString: @"@"];
+		NSMutableArray* classes = [NSMutableArray arrayWithObject: record[@"c"]];
+		for (NSString* ancestor in record[@"s"])
+		{
+			m_ancestors.push_back([ancestor UTF8String]);
+			[classes addObject: ancestor];
+		}
+		if (![classes containsObject: @"IOService"])
+			[classes addObject: @"IOService"];
+		m_properties = [propertiesFor(record) copy];
+		NSMutableDictionary* matching = [NSMutableDictionary dictionary];
+		matching[@"IOProviderClass"] = classes;
+		matching[@"IOClass"] = record[@"c"];
+		matching[@"IONameMatch"] = at.location == NSNotFound ? name : [name substringToIndex: at.location];
+		if ([m_properties[@"BSD Name"] isKindOfClass: [NSString class]])
+			matching[@"BSD Name"] = m_properties[@"BSD Name"];
+		m_matching = [matching copy];
+	}
+
+	const char* className() const override { return m_class.c_str(); }
+	NSDictionary* matchingDictionary() override { return m_matching; }
+	NSDictionary* getProperties() override { return m_properties; }
+
+	bool conformsTo(const char* className) override
+	{
+		if (m_class == className)
+			return true;
+		for (const std::string& ancestor : m_ancestors)
+			if (ancestor == className)
+				return true;
+		return IOService::conformsTo(className);
+	}
+
+private:
+	std::string m_class;
+	std::vector<std::string> m_ancestors;
+	NSDictionary* m_properties;
+	NSDictionary* m_matching;
+};
+
+std::map<std::string, IORegistryEntry*> g_byName;
+
+NSDictionary* recordedPlane()
+{
+	uLongf size = kStaticRegistrySize;
+	NSMutableData* plist = [NSMutableData dataWithLength: size];
+	if (uncompress((Bytef*) [plist mutableBytes], &size, kStaticRegistryData, sizeof(kStaticRegistryData)) != Z_OK
+		|| size != kStaticRegistrySize)
+		return nil;
+	id parsed = [NSPropertyListSerialization propertyListWithData: plist options: 0 format: NULL error: NULL];
+	return [parsed isKindOfClass: [NSDictionary class]] ? parsed : nil;
+}
+
+}
+
+const char* IOStaticRegistry::model()
+{
+	auto found = identity().find("hw.model");
+	return found == identity().end() ? "" : found->second.c_str();
+}
+
+IORegistryEntry* IOStaticRegistry::find(const char* name)
+{
+	auto found = g_byName.find(name);
+	return found == g_byName.end() ? nullptr : found->second;
+}
+
+bool IOStaticRegistry::load(ServiceRegistry* registry, IORegistryEntry* platform)
+{
+	NSDictionary* plane = recordedPlane();
+	NSArray* records = plane[@"entries"];
+	if (!plane || ![plane[@"model"] isEqual: [NSString stringWithUTF8String: model()]]
+		|| ![records isKindOfClass: [NSArray class]])
+	{
+		if (!plane)
+			os_log_error(OS_LOG_DEFAULT, "iokitd: recorded registry is unreadable; publishing the flat layout");
+		return false;
+	}
+
+	// nullptr marks an entry that is not published; nothing below it is either.
+	std::vector<IORegistryEntry*> entries;
+	entries.reserve([records count]);
+	for (NSDictionary* record in records)
+	{
+		const long parentIndex = [record[@"p"] longValue];
+		IORegistryEntry* parent = parentIndex < 0 ? IORegistryEntry::root()
+			: size_t(parentIndex) < entries.size() ? entries[parentIndex] : nullptr;
+		const char* name = [record[@"n"] UTF8String];
+		NSString* live = record[@"l"];
+		IORegistryEntry* entry = nullptr;
+
+		if (!parent)
+			;
+		else if ([live isEqual: @"platform"])
+			entry = platform;
+		else if ([live isEqual: @"power"])
+		{
+			IOPMrootDomain::registerSelf(registry, parent);
+			entry = IOPMrootDomain::instance();
+		}
+		else if ([live isEqual: @"surface"])
+		{
+			IOSurfaceRoot::registerSelf(registry, parent);
+			entry = IOSurfaceRoot::instance();
+		}
+		else if (!live)
+		{
+			// Metal names its devices by these IDs; they belong to the live accelerators.
+			uint64_t wanted = [record[@"i"] unsignedLongLongValue];
+			if (wanted == IOGraphicsIdentity::kIntegratedRegistryID || wanted == IOGraphicsIdentity::kDiscreteRegistryID)
+				wanted = 0;
+			IOStaticService* service = new IOStaticService(wanted, record);
+			service->registerInPlane(kIOServicePlane, name, parent);
+			registry->registerService(service);
+			entry = service;
+		}
+		entries.push_back(entry);
+		if (entry)
+			g_byName.emplace(name, entry);
+	}
+	os_log(OS_LOG_DEFAULT, "iokitd: published the recorded %{public}s registry (%lu entries)",
+		model(), (unsigned long) g_byName.size());
+	return true;
+}
